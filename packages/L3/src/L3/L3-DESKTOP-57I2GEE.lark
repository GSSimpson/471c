program     : "(" PROGRAM "(" parameters ")" term ")"
parameters  : IDENTIFIER*

term        : let
            | letrec
            | reference
            | abstract
            | apply
            | immediate
            | primitive
            | branch
            | allocate
            | load
            | store
            | begin


let         : "(" LET "(" bindings ")" term ")"

letrec      : "(" LETREC "(" bindings ")" term ")"

bindings    : binding*
binding     : IDENTIFIER term

PROGRAM.2   : "l3"
LET.2       : "let"
LETREC.2    : "letrec"
LAMBDA.2    : "\\" | "lambda" | "λ"

IDENTIFIER  : /[a-zA-Z_][a-zA-Z0-9_]*/







//new stuff


reference   : "(" name ")"
name        : IDENTIFIER

abstract    : "(" LAMBDA "(" parameters ")" body ")" //get back to this
body        : term

apply       : "(" target "(" arguments ")" ")"
target      : term
arguments   : term*

immediate   : "(" value ")"
value       : /[0-9]*///make from nat to int

primitive   : "(" operator left right ")"
operator    : "+"|"-"|"*"
left        : term
right       : term

branch      : "(" "if" "("operator2 left right")" consequent otherwise ")"
operator2   : "<"|"=="
consequent  : term
otherwise   : term

allocate    : "(" ALLOCATE count ")"
count       : /[0-9]*/

load        : "(" LOAD base index")"
base        : term
index       : /[0-9]*/

store       : "(" STORE base index value2 ")" //look for workarounds against 'value2'
value2      : term

begin       : "(" BEGIN effects value2 ")"
effects     : term*


ALLOCATE.2  : "allocate"
LOAD.2      : "load"
STORE.2     : "store"
BEGIN.2     : "begin"